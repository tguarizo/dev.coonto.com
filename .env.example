# Endereço e operação
APP_URL=https://dev.coonto.com
DOMAIN=dev.coonto.com
CRM_DOMAIN=crm.dev.coonto.com
APP_PORT=3100
ADMIN_EMAILS=tguarizo@alt360.com.br
CADDYFILE=/etc/caddy/Caddyfile
CADDY_SERVICE=caddy
CADDY_BACKUP_ROOT=/var/backups/coonto/caddy

# PostgreSQL interno — o instalador gera a senha
POSTGRES_DB=coonto_dev
POSTGRES_USER=coonto_app
POSTGRES_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10

# Autenticação — validation usa um código compartilhado temporário
AUTH_MODE=validation
AUTH_SECRET=CHANGE_ME
VALIDATION_ACCESS_CODE=CHANGE_ME

# Quando houver SMTP, alterar AUTH_MODE para email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Coonto <acesso@coonto.com>"

# Regras do produto
OFFLINE_LICENSE_DAYS=30
MAX_USER_DEVICES=2
BACKUP_RETENTION_DAYS=30

# Stripe — deixar vazio até a ativação comercial
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WORK=
STRIPE_PRICE_CLUB=

# Ajuda Coonto — somente no servidor; banco aprovado funciona sem IA
COONTO_AI_ENABLED=false
OPENAI_API_KEY=
COONTO_AI_MODEL=gpt-5-mini
COONTO_AI_DAILY_LIMIT=20
COONTO_AI_INPUT_USD_PER_MILLION=0.25
COONTO_AI_OUTPUT_USD_PER_MILLION=2

# Áudio pré-produzido — não há geração em cada reprodução
ELEVENLABS_API_KEY=
ELEVENLABS_NARRATOR_VOICE_ID=
ELEVENLABS_BACAMARTE_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# SMS — aguarda fornecedor; login por e-mail continua ativo
SMS_ENABLED=false
COONTO_AUDIO_DIR=/app/audio
COONTO_AUDIO_DAILY_CHAR_LIMIT=20000

# SMTP Locaweb: smtplw.com.br, 587 com STARTTLS ou 465 com TLS.
# Preencher usuário, senha e remetente autorizado somente no .env privado.
# Para produção: AUTH_MODE=email. Não usar código compartilhado de validation.

# MKM Service: completar usando a configuração privada e validar a resposta da API
# antes de ativar SMS_ENABLED=true. Não copiar o cookie da ferramenta de exemplo.
SMS_API_TOKEN=
SMS_COST_CENTRE_ID=20275

# Imagens incorporadas de O Alienista, trocadas a cada 2 dias (horário de Brasília).
LOGIN_IMAGE_IDS=phase1,phase2,phase3,phase4,phase5
LOGIN_IMAGE_START=2026-09-30T00:00:00-03:00
